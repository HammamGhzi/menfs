# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Ambil dari: Supabase → Project Settings → Database → Connection String
# Pakai "Transaction" mode (port 6543) untuk DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pakai "Session" mode (port 5432) untuk DIRECT_URL (migrasi)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_random_string_64_karakter_di_production
JWT_EXPIRES_IN=24h

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL Vercel FE kamu (pisah koma kalau lebih dari satu)
FRONTEND_URL=https://nama-app-kamu.vercel.app

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_SUBMIT=5

# ─── Instagram (Content Publishing API — jalur resmi) ───────────────────────
# Token diambil dari Meta: https://developers.facebook.com/apps
#   App Dashboard > Instagram > API setup with Instagram business login
#   > Generate token  (token ini sudah long-lived, valid 60 hari)
# JANGAN pakai username/password — library login reverse-engineered
# (instagram-private-api / instagrapi) melanggar ToS Instagram dan bisa
# membuat akun kena ban permanen.
#
# ID akun Instagram Professional (numeric, tanpa @). Ambil dari:
#   GET https://graph.instagram.com/v26.0/me?fields=id,username
IG_USER_ID=1234567890
IG_ACCESS_TOKEN=token_dari_meta_app_dashboard

# URL publik backend. WAJIB — Instagram di sisi Meta akan MENGAMBIL gambar
# dari URL ini, jadi localhost tidak akan bisa dipakai.
# Di Render: https://<nama-app>.onrender.com
PUBLIC_BASE_URL=https://nama-app-kamu.onrender.com

# Set true untuk menguji alur tanpa memanggil Meta sama sekali.
# HAPUS di production — jangan sampai ada posting sungguhan tanpa sengaja.
IG_DRY_RUN=false

# Opsional. Override kalau Meta merilis versi API yang lebih baru.
IG_GRAPH_VERSION=v26.0

