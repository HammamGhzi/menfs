# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Ambil dari: Supabase → Project Settings → Database → Connection String
# Pakai "Transaction" mode (port 6543) untuk DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pakai "Session" mode (port 5432) untuk DIRECT_URL (migrasi)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_random_string_64_karakter_di_production
JWT_EXPIRES_IN=24h

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL Vercel FE kamu (pisah koma kalau lebih dari satu)
FRONTEND_URL=https://nama-app-kamu.vercel.app

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_SUBMIT=5

# ─── Telegram Bot (opsional) ──────────────────────────────────────────────────
# Ambil dari @BotFather. JANGAN commit token asli.
TELEGRAM_BOT_TOKEN=
# Chat ID admin (angka). Bot hanya boleh mengirim ke chat ini.
TELEGRAM_ADMIN_CHAT_ID=
# WAJIB diisi kalau memakai webhook mode. Token acak panjang, misal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kirim juga sebagai secret_token saat mendaftarkan webhook di BotFather.
# Kalau kosong, endpoint /api/telegram/webhook otomatis DITUTUP (403).
TELEGRAM_WEBHOOK_SECRET=
